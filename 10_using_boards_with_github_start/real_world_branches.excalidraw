    },
    {
      "id": "j5MXdtF14pWi3bB56-2Dw",
      "type": "text",
      "x": 249.17173936631946,
      "y": 509.0048363669912,
      "width": 888.779296875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 619156874,
      "version": 427,
      "versionNonce": 1179706518,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793031775484,
      "link": null,
      "locked": false,
      "text": "This is a common pattern of branch structure.\n- Here we're going to make our pull requests into dev/staging. This is quite powerful\nbecause we can deploy staging/testing/dev to a testing environment for Quality assurance\n(QAs try to break stuff and try to make tickets to improve the software).\n- Overtime you merge dev/... to main and main is what all the users use.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a common pattern of branch structure.\n- Here we're going to make our pull requests into dev/staging. This is quite powerful\nbecause we can deploy staging/testing/dev to a testing environment for Quality assurance\n(QAs try to break stuff and try to make tickets to improve the software).\n- Overtime you merge dev/... to main and main is what all the users use.",
      "autoResize": true,
      "lineHeight": 1.25
    },
