      "isDeleted": false,
      "boundElements": [],
      "updated": 1793283079857,
      "link": null,
      "locked": false,
      "text": "End to End tests.\n- this is what it sounds like. \n- a test from a users perspective that goes through\nand clicks through the application as if it were a \nperson.\n- these sound like a great idea, maybe for a large\nestablished company, but these always will break.\nALWAYS break especially at a small company.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "End to End tests.\n- this is what it sounds like. \n- a test from a users perspective that goes through\nand clicks through the application as if it were a \nperson.\n- these sound like a great idea, maybe for a large\nestablished company, but these always will break.\nALWAYS break especially at a small company.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HHIy6dqa9IJqqMAtBNQBc",
      "type": "text",
      "x": 299,
      "y": 328,
      "width": 401.32763671875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 86151802,
      "version": 225,
      "versionNonce": 247822630,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793115962550,
      "link": null,
      "locked": false,
      "text": "Frontend testing is really good in theory but many \ntimes is too brittle and will just slow you down.\nThere are times where it's great, mostly for large\nestablished not changing very often apps.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend testing is really good in theory but many \ntimes is too brittle and will just slow you down.\nThere are times where it's great, mostly for large\nestablished not changing very often apps.",
      "autoResize": true,
      "lineHeight": 1.25
    },
