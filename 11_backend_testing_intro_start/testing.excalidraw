      "locked": false,
      "text": "Backend testing is non negotiable and \nsuper important. This is because we're\nhandling the data, and we need that to be right",
      "fontSize": 13.334459263161566,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend testing is non negotiable and \nsuper important. This is because we're\nhandling the data, and we need that to be right",
      "autoResize": true,
      "lineHeight": 1.25
    },
