      "boundElements": null,
      "updated": 1789485188585,
      "link": null,
      "locked": false,
      "text": "On the server middleware is kind of before the http request\nis handled by the view and also after the http response\ngiven by the view.\n\nMost Frameworks will have something like this because you need it.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On the server middleware is kind of before the http request\nis handled by the view and also after the http response\ngiven by the view.\n\nMost Frameworks will have something like this because you need it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
