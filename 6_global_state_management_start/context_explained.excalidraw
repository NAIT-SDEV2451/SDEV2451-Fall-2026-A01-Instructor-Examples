    {
      "id": "U8nQ1MCKAo1IBGpdufyeQ",
      "type": "text",
      "x": 1120.7809605523812,
      "y": 1253.9026287549582,
      "width": 1081.527587890625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1838501191,
      "version": 259,
      "versionNonce": 1983404137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790695189511,
      "link": null,
      "locked": false,
      "text": "Note: in react you can use a \"useReducer\" + \"useContext\" to be able\nto update a singleton state for the application.\n\nRedux is for extremely large applications (folks have moved away from it a bit)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: in react you can use a \"useReducer\" + \"useContext\" to be able\nto update a singleton state for the application.\n\nRedux is for extremely large applications (folks have moved away from it a bit)",
      "autoResize": true,
      "lineHeight": 1.25
    },
