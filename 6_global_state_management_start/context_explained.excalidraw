    {
      "id": "weRlWWkZsRL9fPZ0poBKL",
      "type": "text",
      "x": 1001.2980331292592,
      "y": 33.627890687432284,
      "width": 537.9358520507812,
      "height": 385,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1931458951,
      "version": 266,
      "versionNonce": 141768457,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790694844741,
      "link": null,
      "locked": false,
      "text": "What if you have a component a\nthat wants to affect the trip \nlist only on the frontend?\n\nin this example we'd need to pass \nthe props down from the app \nto all of the components. \n\n\nThat sucks, we don't want to do that.\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What if you have a component a\nthat wants to affect the trip \nlist only on the frontend?\n\nin this example we'd need to pass \nthe props down from the app \nto all of the components. \n\n\nThat sucks, we don't want to do that.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
